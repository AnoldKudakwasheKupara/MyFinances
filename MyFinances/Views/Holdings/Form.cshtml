@model MyFinances.ViewModels.HoldingFormViewModel
@using MyFinances.Services
@{
    var editing = Model.Id != null;
    var asset = Model.Kind == HoldingKind.Asset;
    ViewData["Title"] = editing ? "Edit " + Model.Name : asset ? "Add asset" : "Add liability";
    ViewData["Crumbs"] = new List<(string, string)> { ("Assets & liabilities", Url.Action("Index")!) };
}

<div class="page-head">
    <div>
        <h1 class="page-heading">@ViewData["Title"]</h1>
        <p class="page-lede">
            @(asset
                ? "Something you own that is not an account: a house, a car, equipment, a share in a business."
                : "Something you owe that is not tracked under Debts & Loans, such as a store account or tax due.")
            Do not add bank balances or debts here — they are already counted.
        </p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Kind" class="form-label"></label>
                    <select asp-for="Kind" class="form-select" asp-items="EnumText.Options<HoldingKind>(Model.Kind)"></select>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="@(asset ? "e.g. House in Borrowdale" : "e.g. Edgars account")" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select" asp-items="EnumText.Options<HoldingCategory>(Model.Category)"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Currency" class="form-label"></label>
                    <select asp-for="Currency" class="form-select" asp-items="EnumText.Options<Currency>(Model.Currency)"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AcquiredOn" class="form-label"></label>
                    <input asp-for="AcquiredOn" class="form-control" type="date" />
                </div>
                @if (!editing)
                {
                    <div class="col-md-6">
                        <label asp-for="Value" class="form-label">@(asset ? "What it is worth today" : "What is owed today")</label>
                        <input asp-for="Value" class="form-control num" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Value" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ValuedOn" class="form-label"></label>
                        <input asp-for="ValuedOn" class="form-control" type="date" />
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsClosed" class="form-check-input" role="switch" />
                            <label asp-for="IsClosed" class="form-check-label"></label>
                        </div>
                        <div class="form-text">Kept for history but left out of your net worth.</div>
                    </div>
                }
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-light" href="@(editing ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))">Cancel</a>
                <button class="btn btn-primary" type="submit">@(editing ? "Save changes" : "Add")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
