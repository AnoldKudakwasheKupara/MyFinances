@model MyFinances.Entities.Holding
@using MyFinances.Services
@inject UserPreferences Preferences
@{
    var h = Model;
    ViewData["Title"] = h.Name;
    ViewData["Crumbs"] = new List<(string, string)> { ("Assets & liabilities", Url.Action("Index")!) };
    await Preferences.GetAsync();
    var valuations = h.Valuations.OrderByDescending(v => v.Date).ThenByDescending(v => v.Id).ToList();
    var latest = valuations.FirstOrDefault();
    var first = valuations.LastOrDefault();
    var form = (MyFinances.ViewModels.ValuationFormViewModel)ViewData["Valuation"]!;
}

<div class="page-head">
    <div>
        <h1 class="page-heading">@h.Name</h1>
        <p class="page-lede mt-1">
            <span class="status-pill @(h.Kind == HoldingKind.Asset ? "tone-green" : "tone-rose")">@h.Kind</span>
            @h.Category.Text()
            @if (h.AcquiredOn != null)
            {
                <span>· acquired @Preferences.Date(h.AcquiredOn)</span>
            }
            @if (h.IsClosed)
            {
                <span class="status-pill tone-slate ms-1">Sold or settled</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" asp-action="Edit" asp-route-id="@h.Id"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
        <form asp-action="Delete" asp-route-id="@h.Id" method="post" class="d-inline" data-confirm="Delete @h.Name and its valuation history?">
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash3" aria-hidden="true"></i> Delete</button>
        </form>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card is-hero">
        <div class="stat-top"><span class="stat-label">Current value</span><span class="stat-icon"><i class="bi bi-tag" aria-hidden="true"></i></span></div>
        <div class="stat-value num">@Money.Format(latest?.Value ?? 0, h.Currency)</div>
        <div class="stat-note">as of @Preferences.Date(latest?.Date)</div>
    </div>
    @if (first != null && latest != null && first != latest)
    {
        var change = latest.Value - first.Value;
        <div class="stat-card">
            <div class="stat-top"><span class="stat-label">Change since @Preferences.Date(first.Date)</span></div>
            <div class="stat-value num @(change < 0 ? "text-danger" : "")">@Money.Signed(change, h.Currency)</div>
            <div class="stat-note">@(first.Value == 0 ? "" : (change / first.Value * 100).ToString("+0.0;-0.0") + "%")</div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header"><span class="panel-title">Valuation history</span></div>
            <ul class="list-rows">
                @foreach (var v in valuations)
                {
                    <li class="list-row">
                        <div class="list-row-main">
                            <span class="list-row-title">@Preferences.Date(v.Date)</span>
                            @if (v.Notes != null)
                            {
                                <span class="list-row-sub">@v.Notes</span>
                            }
                        </div>
                        <div class="list-row-end d-flex align-items-center gap-2">
                            <span class="num fw-semibold">@Money.Format(v.Value, h.Currency)</span>
                            @if (valuations.Count > 1)
                            {
                                <form asp-action="RemoveValuation" method="post" data-confirm="Remove this valuation?">
                                    <input type="hidden" name="id" value="@h.Id" />
                                    <input type="hidden" name="valuationId" value="@v.Id" />
                                    <button class="btn btn-sm btn-light" type="submit" aria-label="Remove valuation"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
        @if (!string.IsNullOrWhiteSpace(h.Notes))
        {
            <p class="text-muted mt-3">@h.Notes</p>
        }
    </div>
    <div class="col-xl-5">
        <div class="card">
            <div class="card-header"><span class="panel-title">Update the value</span></div>
            <div class="card-body">
                <form asp-action="Revalue" asp-route-id="@h.Id" method="post">
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label" for="Valuation_Value">Value (@h.Currency)</label>
                            <input class="form-control num" id="Valuation_Value" name="Valuation.Value" type="number" step="0.01" min="0" value="@form.Value.ToString("0.00")" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label" for="Valuation_Date">On</label>
                            <input class="form-control" id="Valuation_Date" name="Valuation.Date" type="date" value="@form.Date.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Valuation_Notes">Notes</label>
                        <input class="form-control" id="Valuation_Notes" name="Valuation.Notes" placeholder="e.g. Agent's estimate" />
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Save valuation</button>
                </form>
            </div>
        </div>
    </div>
</div>
