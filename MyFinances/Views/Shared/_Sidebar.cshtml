@{
    var current = ViewContext.RouteData.Values["controller"] as string;

    string On(params string[] controllers) =>
        controllers.Any(c => string.Equals(current, c, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";

    var sections = new (string Group, (string Controller, string Icon, string Text, string[] Also)[] Items)[]
    {
        ("Overview", new[]
        {
            ("Home", "speedometer2", "Dashboard", Array.Empty<string>())
        }),
        ("Money", new[]
        {
            ("Transactions", "arrow-left-right", "Transactions", Array.Empty<string>()),
            ("Accounts", "bank", "Accounts", Array.Empty<string>())
        }),
        ("Planning", new[]
        {
            ("Budgets", "pie-chart", "Budgets", Array.Empty<string>()),
            ("Goals", "piggy-bank", "Savings Goals", Array.Empty<string>()),
            ("Debts", "cash-coin", "Debts & Loans", Array.Empty<string>()),
            ("Bills", "calendar-check", "Bills & Recurring", Array.Empty<string>())
        })
    };
}

<nav class="sidebar-nav" id="sidebarNav" aria-label="Main navigation">

    @foreach (var group in sections)
    {
        <div class="nav-group">@group.Group</div>

        foreach (var item in group.Items)
        {
            <a class="nav-item @On([item.Controller, .. item.Also])"
               asp-controller="@item.Controller"
               asp-action="Index">
                <i class="bi bi-@item.Icon" aria-hidden="true"></i> @item.Text
            </a>
        }
    }

    <div class="sidebar-foot">
        <a class="nav-item @On("Settings", "Categories", "ExchangeRates")" asp-controller="Settings" asp-action="Index">
            <i class="bi bi-gear" aria-hidden="true"></i> Settings
        </a>
    </div>

</nav>
