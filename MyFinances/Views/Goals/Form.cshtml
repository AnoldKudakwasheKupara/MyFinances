@model GoalFormViewModel
@using MyFinances.Services
@{
    var editing = Model.Id != null;
    ViewData["Title"] = editing ? "Edit goal" : "New goal";
    ViewData["Crumbs"] = new List<(string, string)> { ("Savings goals", Url.Action("Index")!) };
}

<div class="page-head">
    <div>
        <h1 class="page-heading">@ViewData["Title"]</h1>
        <p class="page-lede">If the money lives in its own savings account, pick it: contributions from other accounts are then recorded as transfers into it.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Emergency Fund" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Icon" class="form-label"></label>
                    <select asp-for="Icon" class="form-select">
                        @foreach (var (icon, example) in GoalFormViewModel.Ideas)
                        {
                            <option value="@icon" selected="@(icon == Model.Icon)">@example</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="TargetAmount" class="form-label"></label>
                    <input asp-for="TargetAmount" class="form-control num" type="number" step="0.01" min="0.01" value="@(Model.TargetAmount == 0 ? "" : Model.TargetAmount.ToString("0.00"))" />
                    <span asp-validation-for="TargetAmount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Currency" class="form-label"></label>
                    <select asp-for="Currency" class="form-select" asp-items="EnumText.Options<Currency>(Model.Currency)"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="TargetDate" class="form-label"></label>
                    <input asp-for="TargetDate" class="form-control" type="date" />
                </div>
                <div class="col-md-8">
                    <label asp-for="AccountId" class="form-label"></label>
                    <select asp-for="AccountId" class="form-select">
                        <option value="">Not in an account of its own</option>
                        @foreach (var a in Model.Accounts)
                        {
                            <option value="@a.Id" selected="@(a.Id == Model.AccountId)">@a.Name (@a.Currency)</option>
                        }
                    </select>
                    <div class="form-text">Must be in the goal's currency.</div>
                </div>
                @if (editing)
                {
                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="EnumText.Options<GoalStatus>(Model.Status)"></select>
                    </div>
                }
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-light" href="@(editing ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))">Cancel</a>
                <button class="btn btn-primary" type="submit">@(editing ? "Save changes" : "Create goal")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
