@page
@model ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Resend confirmation";
}

<div class="auth-head">
    <h1>Resend confirmation</h1>
    <p>Enter your email and we will send the link again.</p>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"
         data-valmsg-summary="true"></div>

    <div class="mb-3">

        <label asp-for="Input.Email" class="form-label">
            Email
        </label>

        <input asp-for="Input.Email"
               class="form-control"
               autocomplete="username"
               aria-required="true"
               placeholder="you@company.com" />

        <span asp-validation-for="Input.Email"
              class="text-danger"></span>

    </div>

    <button type="submit"
            class="btn btn-primary w-100 justify-content-center">
        Resend
    </button>

</form>

<p class="auth-foot-link">
    <a asp-page="./Login">Back to sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
