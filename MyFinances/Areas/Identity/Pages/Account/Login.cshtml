@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-head">
    <h1>Welcome back</h1>
    <p>Sign in with your work account to continue.</p>
</div>

@if (Request.Query["timedOut"] == "1")
{
    <div class="alert alert-info" role="status">
        <i class="fas fa-hourglass-end" aria-hidden="true"></i>
        You were signed out after @MyFinances.Services.SessionTimeout.Idle.TotalMinutes minutes without activity. Sign in
        again to carry on where you left off.
    </div>
}

@if (Request.Query["limited"] == "1")
{
    <div class="alert alert-warning" role="alert">
        There have been too many sign-in attempts from your network.
        Wait a few minutes and try again.
    </div>
}

<form id="account" method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"
         data-valmsg-summary="true"></div>

    <div class="mb-3">

        <label asp-for="Input.Email" class="form-label">
            Email
        </label>

        <span class="field-icon">

            <i class="fas fa-envelope" aria-hidden="true"></i>

            <input asp-for="Input.Email"
                   class="form-control"
                   autocomplete="username"
                   aria-required="true"
                   placeholder="name@company.com" />

        </span>

        <span asp-validation-for="Input.Email"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Input.Password" class="form-label">
            Password
        </label>

        <span class="field-icon has-toggle">

            <i class="fas fa-lock" aria-hidden="true"></i>

            <input asp-for="Input.Password"
                   class="form-control"
                   autocomplete="current-password"
                   aria-required="true"
                   placeholder="Enter your password" />

            <button type="button"
                    class="field-reveal"
                    data-reveal="Input_Password"
                    aria-controls="Input_Password"
                    aria-pressed="false"
                    aria-label="Show password">
                <i class="fas fa-eye-slash" aria-hidden="true"></i>
            </button>

        </span>

        <span asp-validation-for="Input.Password"
              class="text-danger"></span>

    </div>

    <div class="d-flex align-items-center justify-content-between mb-4">

        <div class="form-check mb-0">

            <input class="form-check-input" asp-for="Input.RememberMe" />

            <label asp-for="Input.RememberMe" class="form-check-label">
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>

        </div>

        <a id="forgot-password"
           class="auth-minor"
           asp-page="./ForgotPassword">
            Forgot password?
        </a>

    </div>

    <button id="login-submit"
            type="submit"
            class="btn btn-primary w-100 justify-content-center">
        Sign in securely
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </button>

</form>

<p class="auth-privacy">
    <a asp-area=""
       asp-controller="Home"
       asp-action="Privacy">
        How this portal uses your information
    </a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-reveal.js" asp-append-version="true"></script>
}
