@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Check your email";
}

<div class="auth-head">
    <h1>Check your email</h1>
    <p>
        If that address belongs to an account, a link to reset the
        password is on its way.
    </p>
</div>

<a asp-page="./Login"
   class="btn btn-primary w-100 justify-content-center">
    Back to sign in
</a>
