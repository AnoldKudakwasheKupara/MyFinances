@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password reset";
}

<div class="auth-head">
    <h1>Password reset</h1>
    <p>Your password has been changed. You can sign in with it now.</p>
</div>

<a asp-page="./Login"
   class="btn btn-primary w-100 justify-content-center">
    Sign in
</a>
