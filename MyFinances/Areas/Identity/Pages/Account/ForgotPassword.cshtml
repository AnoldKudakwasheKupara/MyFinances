@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-head">
    <h1>Forgot password</h1>
    <p>Enter your email and we will send you a reset link.</p>
</div>

@if (Request.Query["limited"] == "1")
{
    <div class="alert alert-warning" role="alert">
        Too many reset emails have been asked for. Wait an hour and
        try again, or ask HR to reset your password.
    </div>
}

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"
         data-valmsg-summary="true"></div>

    <div class="mb-3">

        <label asp-for="Input.Email" class="form-label">
            Email
        </label>

        <input asp-for="Input.Email"
               class="form-control"
               autocomplete="username"
               aria-required="true"
               placeholder="you@company.com" />

        <span asp-validation-for="Input.Email"
              class="text-danger"></span>

    </div>

    <button type="submit"
            class="btn btn-primary w-100 justify-content-center">
        Send reset link
    </button>

</form>

<p class="auth-foot-link">
    <a asp-page="./Login">Back to sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
