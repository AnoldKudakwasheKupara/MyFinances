@page
@model RegisterModel

@{
    ViewData["Title"] = "Create your account";
}

@if (!Model.IsOpen)
{
    <div class="auth-head">
        <h1>Sign-up is closed</h1>
        <p>New accounts are not being opened at the moment.</p>
    </div>

    <a asp-page="./Login" class="btn btn-primary w-100">Back to sign in</a>

    return;
}

<div class="auth-head">
    <h1>Create your account</h1>
    <p>A private place for your accounts, spending and plans. It takes a minute.</p>
</div>

@if (Request.Query["limited"] == "1")
{
    <div class="alert alert-warning" role="alert">
        Too many accounts have been opened from your network. Wait a while and try again.
    </div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.FullName" class="form-label"></label>
        <span class="field-icon">
            <i class="bi bi-person" aria-hidden="true"></i>
            <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" />
        </span>
        <span asp-validation-for="Input.FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <span class="field-icon">
            <i class="bi bi-envelope" aria-hidden="true"></i>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
        </span>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ReportingCurrency" class="form-label"></label>
        <select asp-for="Input.ReportingCurrency" class="form-select">
            @foreach (var currency in Enum.GetValues<MyFinances.Entities.Currency>())
            {
                <option value="@currency">@currency — @MyFinances.Services.Money.Name(currency)</option>
            }
        </select>
        <div class="form-text">Totals and reports are shown in this currency. You can change it later.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <span class="field-icon has-toggle">
            <i class="bi bi-lock" aria-hidden="true"></i>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
            <button type="button" class="field-reveal" data-reveal="Input_Password" aria-controls="Input_Password" aria-pressed="false" aria-label="Show password">
                <i class="bi bi-eye-slash" aria-hidden="true"></i>
            </button>
        </span>
        <div class="form-text">At least 8 characters, with an upper-case letter, a lower-case letter and a number.</div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <span class="field-icon">
            <i class="bi bi-lock" aria-hidden="true"></i>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
        </span>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">
        Create my account
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </button>

</form>

<partial name="_ExternalLoginButtons" model="(Model.ExternalLogins, Model.ReturnUrl)" />

<p class="auth-switch">
    Already have an account?
    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-reveal.js" asp-append-version="true"></script>
}
