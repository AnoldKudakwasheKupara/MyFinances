@inject SignInManager<ApplicationUser> SignInManager

@{
    var hasExternalLogins =
        (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var settings = new List<(string Page, string Icon, string Title, string Note)>
    {
        ("./Email", "envelope", "Email",
            "Change the address you sign in with"),

        ("./ChangePassword", "key", "Password",
            "Set a new password for your account"),

        ("./TwoFactorAuthentication", "shield-check",
            "Two-factor authentication",
            "Add a second step when signing in")
    };

    if (hasExternalLogins)
    {
        settings.Add(("./ExternalLogins", "link-45deg", "External logins",
            "Accounts linked for signing in"));
    }

    settings.Add(("./PersonalData", "database", "Personal data",
        "Download or delete your account data"));
}

<div class="settings-grid">

    @foreach (var item in settings)
    {
        var page = item.Page.TrimStart('.', '/');

        <a class="settings-item @(current.EndsWith("/" + page) ? "is-current" : "")"
           asp-page="@item.Page">

            <span class="settings-icon">
                <i class="bi bi-@item.Icon" aria-hidden="true"></i>
            </span>

            <span class="settings-text">
                <span class="settings-title">@item.Title</span>
                <span class="settings-note">@item.Note</span>
            </span>

            <i class="bi bi-chevron-right settings-chevron"
               aria-hidden="true"></i>

        </a>
    }

</div>
