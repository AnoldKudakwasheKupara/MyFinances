@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="page-head">
    <div>
        <h1 class="page-heading">Personal data</h1>
        <p class="page-lede">What MyFinances holds about you, how to take a copy, and how to close your account.</p>
    </div>
</div>

<div class="row g-3">

    <div class="col-lg-6">

        <div class="card h-100">

            <div class="card-header">Take a copy</div>

            <div class="card-body d-flex flex-column">

                <p class="text-muted small">
                    Your sign-in details download as a JSON file: your name,
                    email address, phone number and whether each is confirmed.
                </p>

                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="mt-auto">
                    <button class="btn btn-light" type="submit">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        Download sign-in details
                    </button>
                </form>

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card h-100">

            <div class="card-header">Close your account</div>

            <div class="card-body d-flex flex-column">

                <p class="text-muted small">
                    Closing your account deletes your sign-in and every record
                    in it: accounts, transactions, budgets, goals, debts, bills
                    and receipts. It cannot be undone, so take a copy first.
                </p>

                <a class="btn btn-outline-danger mt-auto align-self-start" asp-page="DeletePersonalData">
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                    Close my account
                </a>

            </div>

        </div>

    </div>

</div>
