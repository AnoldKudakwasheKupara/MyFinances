@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="container-fluid">

    <div class="page-head-simple">

        <h2>Email</h2>

        <p class="text-muted">
            The address you sign in with, and where MyFinances sends you
            notifications.
        </p>

    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row g-3">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header">Your address</div>

                <div class="card-body">

                    <form id="email-form" method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"
                             role="alert"></div>

                        <div class="mb-4">

                            <span class="field-label">Current address</span>

                            <div class="d-flex align-items-center gap-2 mt-1">

                                <span class="field-value mb-0">
                                    @Model.Email
                                </span>

                                @if (Model.IsEmailConfirmed)
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Not confirmed
                                    </span>
                                }

                            </div>

                            @if (!Model.IsEmailConfirmed)
                            {
                                <button id="email-verification"
                                        type="submit"
                                        asp-page-handler="SendVerificationEmail"
                                        class="btn btn-sm btn-outline-secondary mt-2">
                                    Send verification email
                                </button>
                            }

                        </div>

                        <div class="mb-4">

                            <label asp-for="Input.NewEmail"
                                   class="form-label">
                                New address
                            </label>

                            <input asp-for="Input.NewEmail"
                                   class="form-control"
                                   autocomplete="email"
                                   aria-required="true"
                                   placeholder="you@example.com" />

                            <div class="form-text">
                                We send a confirmation link to the new
                                address. The change takes effect once you
                                follow it.
                            </div>

                            <span asp-validation-for="Input.NewEmail"
                                  class="text-danger"></span>

                        </div>

                        <button id="change-email-button"
                                type="submit"
                                asp-page-handler="ChangeEmail"
                                class="btn btn-primary">
                            Change email
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mt-3 mb-4">

        <div class="card-header">Account settings</div>

        <div class="card-body">
            <partial name="_ManageNav" />
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
